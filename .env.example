# Raw storage + warehouse cùng 1 GCP project — chỉ cần 1 bộ credentials.
# Đặt service account json thật tại ./keys/bq-service-account.json (thư mục
# `keys/` đã gitignore, không commit key thật).
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/keys/bq-service-account.json
BQ_PROJECT=your-gcp-project
BQ_DATASET=stock_pipeline

# Cloud Storage (raw layer)
GCS_BUCKET=your-gcs-bucket-name
GCS_LOCATION=asia-southeast1

# Airflow metadata DB
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
